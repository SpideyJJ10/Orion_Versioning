# ─── Required ──────────────────────────────────────────────────────────
# URL del backend FastAPI.
#   local           → http://localhost:8000
#   Vercel preview  → https://orion-pos-staging.onrender.com
#   Vercel prod     → https://orion-pos.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Optional ──────────────────────────────────────────────────────────
# Habilita devtools de React Query en producción local (no en deploy real)
NEXT_PUBLIC_DEV_TOOLS=false

# ─── Sentry (optional, recommended in Vercel) ─────────────────────────
# Frontend Sentry DSN — exposed to the browser, safe by design.
# Leave empty to disable. Set in Vercel project settings, not committed here.
# NEXT_PUBLIC_SENTRY_DSN=

# Server-side variables for source-map upload at build time.
# These MUST live as plain (not NEXT_PUBLIC_) Vercel env vars.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=oriontech
# SENTRY_PROJECT=orion-frontend
