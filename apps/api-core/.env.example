# Copy this file to .env and adjust the values.
#   cp  .env.example .env       (Linux/macOS)
#   copy .env.example .env       (Windows / PowerShell)

# ── Environment ──────────────────────────────────────────────────
# dev  → local development (loose CORS, no HSTS)
# prod → production (strict CORS required, HSTS on)
ENV=dev
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────
# SQLite for local dev (file is created at first run)
DATABASE_URL=sqlite:///./tizon.db
# PostgreSQL for prod / staging — uncomment and fill in:
# DATABASE_URL=postgresql://user:password@host:5432/orion?sslmode=require

# ── JWT (REQUIRED) ───────────────────────────────────────────────
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-32+-char-random-string
# Optional comma-separated list of OLD keys to keep accepting during rotation
# SECRET_KEYS_OLD=

# ── Admin bootstrap (creates the first super-admin on cold start) ─
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PIN=

# ── CORS (REQUIRED in prod) ──────────────────────────────────────
# In dev you may use "*". In prod a wildcard is REJECTED at startup
# by backend/core/security.py::strict_cors_origins().
CORS_ORIGINS=http://localhost:3000
# Optional regex for dynamic origins (e.g. Vercel preview deploys).
# Example for the Vercel project `orion-pos`:
#   CORS_ORIGIN_REGEX=^https://orion-pos-.*\.vercel\.app$
# CORS_ORIGIN_REGEX=

# ── Rate limiting (slowapi) ──────────────────────────────────────
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_ASSISTANT=100/day

# ── Brute-force tracker ──────────────────────────────────────────
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# ── Optional Content-Security-Policy override ────────────────────
# CSP_POLICY=

# ── AI integrations (optional) ───────────────────────────────────
# For OpenAI Cloud:
# OPENAI_API_KEY=sk-...
#
# For Local LM Studio (no cloud API key needed):
# LM_STUDIO_URL=http://localhost:1234/v1
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=qwen2.5-coder-7b-instruct

# ── Stripe payments & subscriptions (optional) ─────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...

# ── Observability (optional) ─────────────────────────────────────
# Backend Sentry — leave SENTRY_DSN empty to disable (init_sentry is a no-op).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=prod                # default falls back to ENV
# SENTRY_RELEASE=                        # set in CI to ${{ github.sha }}
# SENTRY_TRACES_SAMPLE_RATE=0.1          # 0..1, default 0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.0        # 0..1, default 0.0
